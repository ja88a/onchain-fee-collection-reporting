{
  "name": "@jabba01/lfcr-events-scraper",
  "version": "0.2.0",
  "description": "Service that scrapes onchain events generated by LI.FI FeeCollector contracts on a given blockchain and store these events in a database.",
  "author": {
    "name": "Jabba ø1",
    "email": "jabba@srenault.com",
    "url": "https://github.com/ja88a"
  },
  "repository": {
    "url": "https://github.com/ja88a/onchain-fee-collection-reporting",
    "type": "git"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "dist/index",
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "shx rm -rf dist/* artifacts/*",
    "reset": "shx rm -rf dist node_modules .turbo artifacts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "build": "tsc",
    "build:prod": "pnpm clean && esbuild --bundle --outfile=./dist/index.js --platform=node --target=node20 --minify --sourcemap ./src/index.ts",
    "start": "pnpm build && DEV_MODE=1 NODE_ENV=dev node dist/main"
  },
  "dependencies": {
    "@ethersproject/abstract-provider": "^5.8.0",
    "@jabba01/lfcr-common": "workspace:*",
    "@jabba01/lfcr-database": "workspace:*",
    "@lifi/types": "^17.17.0",
    "ethers": "^5.8.0",
    "lifi-contract-typings": "workspace:*"
  },
  "devDependencies": {
  }
}