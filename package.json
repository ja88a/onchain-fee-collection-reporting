{
  "name": "@jabba01/onchain-fee-collection-reporting-workspace",
  "version": "0.1.0",
  "description": "Workspace for the development of an off-chain reporting service for the onchain LI.FI FeeCollector events - off-chain web services",
  "author": {
    "name": "Jabba ø1",
    "email": "jabba@srenault.com",
    "url": "https://github.com/ja88a"
  },
  "repository": {
    "url": "https://github.com/ja88a/onchain-fee-collection-reporting",
    "type": "git"
  },
  "keywords": [
    "lifi",
    "feecollector",
    "report",
    "offchain",
    "services",
    "events"
  ],
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "init:env": "find . -name 'sample.env' -execdir cp .env.sample .env \\;",
    "init:lifi-contract-types": "git submodule update --init --recursive && cd lib/lifi-contract-types && npm pkg delete scripts.build && cd -",
    "init:workspace": "pnpm init:lifi-contract-types && pnpm install && turbo telemetry disable && pnpm build && pnpm init:env",
    "build": "turbo build --log-order stream",
    "format": "turbo format --log-order stream",
    "lint": "turbo lint --log-order stream",
    "docker:build": "docker build -t fees-reporter-api-dev:latest --build-arg PROJECT_PACKAGE=@jabba01/lfcr-fees-reporter-api --build-arg PROJECT_PATH=packages/fees-reporter-api --build-arg API_PORT=3000 .",
    "docker:run": "docker run --rm --env-file ./.env -i --name fees-reporter-api-dev fees-reporter-api-dev:latest",
    "docker:up": "dotenv -e ./.env -- docker compose up",
    "docker:up:rebuild": "pnpm i && dotenv -e ./.env -- docker compose up --force-recreate --build --remove-orphans",
    "docker:stop": "docker compose stop",
    "docker:down": "docker compose down",
    "docker:db:start": "docker compose up -d lfcr-db",
    "start": "turbo start --log-order stream",
    "test": "turbo test",
    "reset": "turbo reset && shx rm -rf node_modules .turbo",
    "turbo:stop": "turbo daemon clean"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "dotenv-cli": "^8.0.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "jest": "^29.7.0",
    "jiti": "^2.4.2",
    "mongodb-memory-server": "^9.1.5",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.5.3",
    "shx": "^0.4.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.3.4",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
