{
  "name": "@jabba01/lfcr-events-scraper",
  "version": "0.2.0",
  "description": "A serverless service that scrapes onchain events generated by LI.FI FeeCollector contracts on a given blockchain.",
  "author": {
    "name": "Jabba ø1",
    "email": "jabba@srenault.com",
    "url": "https://github.com/ja88a"
  },
  "repository": {
    "url": "https://github.com/ja88a/onchain-fee-collection-reporting",
    "type": "git"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "dist/main",
  "type": "commonjs",
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "shx rm -rf dist/* artifacts/*",
    "reset": "shx rm -rf dist node_modules .serverless .turbo artifacts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "serve": "tsx ./src/main.ts",
    "test": "vitest run",
    "build": "pnpm clean && tsc --build tsconfig.build.json",
    "build:prod": "pnpm clean && esbuild --bundle --outfile=./dist/main.js --platform=node --target=node20 --minify --sourcemap ./src/main.ts",
    "zip": "zip -j lambda.zip dist/main.js",
    "aws:update": "aws lambda update-function-code --zip-file file://lambda.zip --function-name hello",
    "aws:deploy": "run-s build:prod zip aws:update",
    "serverless:offline": "serverless offline",
    "serverless:dev": "serverless dev",
    "serverless:deploy": "serverless deploy",
    "serverless:remove": "serverless remove --force --all",
    "start": "pnpm build:prod && pnpm serverless:offline",
    "start:local": "pnpm build:prod && DEV_MODE=1 NODE_ENV=dev node dist/main"
  },
  "dependencies": {
    "@ethersproject/abstract-provider": "^5.8.0",
    "@jabba01/lfcr-common": "workspace:*",
    "@jabba01/lfcr-database": "workspace:*",
    "@lifi/types": "^17.17.0",
    "aws-lambda": "^1.0.7",
    "ethers": "^5.8.0",
    "hono": "^4.7.11",
    "lifi-contract-typings": "workspace:*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149"
  }
}