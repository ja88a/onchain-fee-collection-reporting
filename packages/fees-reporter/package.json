{
  "name": "@jabba01/lfcr-fees-reporter",
  "version": "0.2.0",
  "description": "LiFi onchain fees collection reporting service",
  "author": {
    "name": "Jabba ø1",
    "email": "jabba@srenault.com",
    "url": "https://github.com/ja88a"
  },
  "repository": {
    "url": "https://github.com/ja88a/onchain-fee-collection-reporting",
    "type": "git"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "dist/index.js",
  "files":[
    "/dist"
  ],
  "scripts": {
    "clean": "shx rm -rf dist/*",
    "reset": "shx rm -rf dist node_modules .turbo",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "npm:lock": "npm i --package-lock-only true",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:cov": "vitest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/vitest --runInBand",
    "test:e2e": "vitest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@jabba01/lfcr-common": "workspace:^",
    "@jabba01/lfcr-database": "workspace:^",
    "@lifi/types": "^17.18.0",
    "viem": "^2.31.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/lib-config-typescript": "workspace:*"
  }
}
