{
  "name": "@jabba01/lfcr-common",
  "version": "0.1.0",
  "description": "Sets of data and utilities used by the FeeCollector offchain services.",
  "author": {
    "name": "Jabba ø1",
    "email": "jabba@srenault.com",
    "url": "https://github.com/ja88a"
  },
  "repository": {
    "url": "https://github.com/ja88a/feecollector-report",
    "type": "git"
  },
  "keywords": [],
  "license": "AGPL-3.0-only",
  "main": "dist/index",
  "scripts": {
    "clean": "shx rm -rf dist/* coverage/*",
    "reset": "shx rm -rf dist node_modules .turbo coverage",
    "build": "pnpm clean && tsc",
    "build:prod": "pnpm clean && tsc -p tsconfig.build.json",
    "build:webpack": "webpack --config webpack.config.js",
    "watch": "tsc -w",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@lifi/types": "^17.17.0",
    "ethers": "^5.8.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "run-script-webpack-plugin": "^0.2.3",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.5",
    "typescript": "^5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
