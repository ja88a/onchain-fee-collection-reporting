{
  "name": "@jabba01/lfcr-common",
  "version": "0.1.0",
  "description": "Sets of data and utilities used by the FeeCollector offchain services.",
  "author": {
    "name": "Jabba ø1",
    "email": "jabba@srenault.com",
    "url": "https://github.com/ja88a"
  },
  "repository": {
    "url": "https://github.com/ja88a/onchain-fee-collection-reporting",
    "type": "git"
  },
  "keywords": [],
  "license": "AGPL-3.0-only",
  "main": "dist/index",
  "files": [
    "/dist"
  ],
  "scripts": {
    "clean": "shx rm -rf dist/* coverage/*",
    "reset": "shx rm -rf dist node_modules .turbo coverage",
    "build": "tsc",
    "build:bundle": "pnpm clean && esbuild --bundle --outfile=./dist/index.js --platform=node --target=node20 --minify --sourcemap ./src/index.ts",
    "watch": "tsc -w",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:cov": "vitest --coverage"
  },
  "dependencies": {
    "@lifi/types": "^17.17.0",
    "ethers": "^5.8.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/lib-config-typescript": "workspace:*"
  }
}
