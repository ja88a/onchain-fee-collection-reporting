{
  "name": "@jabba01/lfcr-events-scraper",
  "version": "0.2.0",
  "description": "Service that scrapes onchain events generated by LI.FI FeeCollector contracts on a given blockchain and store these events in a database.",
  "author": {
    "name": "Jabba ø1",
    "email": "jabba@srenault.com",
    "url": "https://github.com/ja88a"
  },
  "repository": {
    "url": "https://github.com/ja88a/onchain-fee-collection-reporting",
    "type": "git"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "dist/index",
  "files": [
    "/dist"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "shx rm -rf dist/* artifacts/*",
    "reset": "shx rm -rf dist node_modules .turbo artifacts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "build": "tsc",
    "build:prod": "tsc -p tsconfig.build.json",
    "build:bundle": "pnpm clean && esbuild --bundle --outfile=./dist/index.js --platform=node --target=node20 --minify --sourcemap ./src/index.ts",
    "start": "dotenv -e ../../.env -- node dist/main",
    "start:build": "pnpm -w build && dotenv -e ../../.env -- tsx src/main"
  },
  "dependencies": {
    "@jabba01/lfcr-common": "workspace:*",
    "@jabba01/lfcr-database": "workspace:*",
    "@lifi/types": "^17.17.0",
    "viem": "^2.31.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/lib-config-typescript": "workspace:*",
    "ethers": "^5.8.0"
  }
}